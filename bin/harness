#!/usr/bin/env bash
set -euo pipefail

# Convenience wrapper around harness-os's human-facing CLI subcommands, so
# nobody has to hand-type the underlying `docker run`/`docker exec`
# invocations (plan §2.2/§2.3, §12.6). Two invocation models are used
# deliberately, matching the project's own architecture:
#   - init/reconcile-config read+write a project's files and must actually
#     commit to git, so they run via their own ephemeral, writable-mount
#     `docker run`, launched as the calling host user so created/edited
#     files stay host-owned (Open Item #21) instead of root-owned.
#     reconcile-config uses this same model rather than `docker exec` into
#     harness_gate_daemon — that daemon's /workspaces mount is read-only, so
#     its commit always failed there (Open Item #13/#22); the writable mount
#     closes that gap.
#   - approve only touches Postgres, never a project's filesystem, so it
#     reaches the already-warm harness_gate_daemon container via `docker
#     exec` instead of paying a `docker run` cold start.
# All three subcommands are TTY-gated by their own Node code (§2.1, §3.5a) —
# this script's job is just to make sure a real TTY actually reaches them.

HARNESS_NETWORK="${HARNESS_NETWORK:-harness_os_default}"
HARNESS_IMAGE="${HARNESS_IMAGE:-harness-os:latest}"
HARNESS_DATABASE_URL="${HARNESS_DATABASE_URL:-postgres://harness_app:harness_app@harness_postgres:5432/harness_os}"
HARNESS_DAEMON_NAME="${HARNESS_DAEMON_NAME:-harness_gate_daemon}"

usage() {
  cat <<'EOF'
Usage: harness <command> [args]

Commands:
  init <project-path> [--prefix PREFIX]   Scaffold governance for a new project (TTY-gated)
  reconcile-config <project-path>         Re-verify and trust config after a legitimate change (TTY-gated)
  approve <decision-id>                   Approve a pending Critical-risk decision (TTY-gated)

Environment overrides:
  HARNESS_NETWORK        docker network to attach to (default: harness_os_default)
  HARNESS_IMAGE          image to run (default: harness-os:latest)
  HARNESS_DATABASE_URL   Postgres URL passed to the container
  HARNESS_DAEMON_NAME    container name of the persistent gate daemon (default: harness_gate_daemon)
EOF
}

require_tty() {
  if [ ! -t 0 ]; then
    echo "harness $1 must be run from an interactive terminal (not piped, not from a script)." >&2
    exit 1
  fi
}

resolve_abs_path() {
  # docker run -v and the container's own --project-path argument must agree
  # on the identical absolute host path (project-path.ts's ambient-passthrough
  # assumption, plan §12.6) — a relative path would mount at the wrong spot.
  (cd "$1" >/dev/null 2>&1 && pwd) || { echo "No such directory: $1" >&2; exit 1; }
}

cmd_init() {
  require_tty init
  local project_path="${1:?Usage: harness init <project-path> [--prefix PREFIX]}"
  shift
  project_path="$(resolve_abs_path "$project_path")"

  docker run --rm -it --network "$HARNESS_NETWORK" \
    --user "$(id -u):$(id -g)" -e HOME=/tmp \
    -v "$project_path:$project_path" \
    -e DATABASE_URL="$HARNESS_DATABASE_URL" \
    "$HARNESS_IMAGE" harness-init --project-path "$project_path" "$@"
}

cmd_reconcile_config() {
  require_tty reconcile-config
  local project_path="${1:?Usage: harness reconcile-config <project-path>}"
  project_path="$(resolve_abs_path "$project_path")"

  docker run --rm -it --network "$HARNESS_NETWORK" \
    --user "$(id -u):$(id -g)" -e HOME=/tmp \
    -v "$project_path:$project_path" \
    -e DATABASE_URL="$HARNESS_DATABASE_URL" \
    "$HARNESS_IMAGE" reconcile-config --project-path "$project_path"
}

cmd_approve() {
  require_tty approve
  local decision_id="${1:?Usage: harness approve <decision-id>}"

  docker exec -it "$HARNESS_DAEMON_NAME" node cli/dist/approve.js "$decision_id"
}

case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  reconcile-config) shift; cmd_reconcile_config "$@" ;;
  approve) shift; cmd_approve "$@" ;;
  -h|--help|help|"") usage ;;
  *) echo "Unknown command: $1" >&2; usage; exit 1 ;;
esac
